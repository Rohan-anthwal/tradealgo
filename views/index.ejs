<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upstox Trading Bot Configuration</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        /* General body and container styling for a clean, centered layout */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            color: #333;
        }

        .form-container {
            background-color: #ffffff;
            padding: 2.5rem;
            border-radius: 1rem;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 420px;
            box-sizing: border-box;
            margin: 1rem;
        }

        h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: #1a202c;
            text-align: center;
            margin-bottom: 2rem;
        }

        /* Form styling */
        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #4a5568;
        }

        input[type="text"] {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.5rem;
            font-size: 1rem;
            box-sizing: border-box;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input[type="text"]:focus {
            outline: none;
            border-color: #3182ce;
            box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.2);
        }

        /* Button styling */
        button {
            width: 100%;
            padding: 0.875rem;
            background-color: #4f46e5;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.1s;
        }

        button:hover {
            background-color: #4338ca;
        }

        button:active {
            transform: scale(0.99);
        }
        
        button:disabled {
            background-color: #9ca3af;
            cursor: not-allowed;
        }

        /* Message box styling */
        .message {
            margin-top: 1.5rem;
            padding: 0.75rem;
            border-radius: 0.5rem;
            font-size: 0.875rem;
            text-align: center;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .success {
            background-color: #d1fae5;
            color: #065f46;
        }

        .error {
            background-color: #fee2e2;
            color: #991b1b;
        }
    </style>
</head>
<body>

    <!-- Login Form -->
    <div class="form-container">
        <h1>Trading Bot Login</h1>
        <form id="loginForm">
            <div class="form-group">
                <label for="clientid">Client ID</label>
                <input type="text" id="clientid" name="clientid" placeholder="e.g., A1B2C3D4E5F6G7H8I9J0K1L2" required>
            </div>
            <div class="form-group">
                <label for="secret">Secret</label>
                <input type="text" id="secret" name="secret" placeholder="e.g., Z9Y8X7W6V5U4T3S2R1Q0P9O8" required>
            </div>
            <button type="submit">Login</button>
            <div id="loginMessage" class="message"></div>
        </form>
    </div>
    <script>
        document.getElementById('loginForm').addEventListener('submit', async function(event) {
            event.preventDefault();
            
            const form = event.target;
            const button = form.querySelector('button');
            const messageDiv = document.getElementById('loginMessage');

            button.disabled = true;
            button.textContent = 'Logging in...';
            messageDiv.style.opacity = '0';

            const formData = new URLSearchParams(new FormData(form)).toString();

            try {
                const response = await fetch('/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: formData,
                });

                if (response.ok) {
                    messageDiv.textContent = 'Login credentials submitted successfully!';
                    messageDiv.className = 'message success';
                } else {
                    const errorText = await response.text();
                    messageDiv.textContent = `Error: ${response.status} - ${errorText}`;
                    messageDiv.className = 'message error';
                }
            } catch (error) {
                console.error('Fetch error:', error);
                messageDiv.textContent = 'Failed to connect to the server. Please check the console.';
                messageDiv.className = 'message error';
            } finally {
                button.disabled = false;
                button.textContent = 'Login';
                messageDiv.style.opacity = '1';
            }
        });
    </script>
    </body>
</html>